{
  "name": "nostandard-tidy",
  "version": "0.3.0",
  "description": "Shared base configs for fallow and dependency-cruiser that keep codebase structure tidy.",
  "license": "MIT",
  "author": "Daniele Dellafiore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ildella/nostandard-tidy.git"
  },
  "keywords": [
    "fallow",
    "dependency-cruiser",
    "architecture",
    "config"
  ],
  "files": [
    "fallow/",
    "depcruise/",
    "bin/",
    "lib/",
    "skills/"
  ],
  "bin": {
    "tidy": "./bin/tidy.js"
  },
  "exports": {
    "./fallow/basic.jsonc": "./fallow/basic.jsonc",
    "./fallow/recommended.jsonc": "./fallow/recommended.jsonc",
    "./fallow/strict.jsonc": "./fallow/strict.jsonc",
    "./fallow/dead-code.tidy.jsonc": "./fallow/dead-code.tidy.jsonc",
    "./fallow/complexity.tidy.jsonc": "./fallow/complexity.tidy.jsonc",
    "./fallow/health.tidy.jsonc": "./fallow/health.tidy.jsonc",
    "./fallow/duplication.tidy.jsonc": "./fallow/duplication.tidy.jsonc",
    "./fallow/architecture.tidy.jsonc": "./fallow/architecture.tidy.jsonc",
    "./fallow/styling.tidy.jsonc": "./fallow/styling.tidy.jsonc",
    "./fallow/all.tidy.jsonc": "./fallow/all.tidy.jsonc",
    "./depcruise/basic.cjs": "./depcruise/basic.cjs",
    "./depcruise/hygiene.mjs": "./depcruise/hygiene.mjs",
    "./depcruise/boundaries.mjs": "./depcruise/boundaries.mjs",
    "./depcruise/options.mjs": "./depcruise/options.mjs",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "dependency-cruiser": "^18.6.0",
    "fallow": "^3.39.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node script/check.js && node --test test/*.test.js",
    "audit.prod": "npm audit --omit=dev --audit-level=moderate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.2",
    "fallow": "3.39.0"
  }
}
