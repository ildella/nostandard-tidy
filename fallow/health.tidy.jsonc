// nostandard-tidy fallow health: CRAP and file length at error.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Cache per checkout in .cache/, so .fallow/ stays free for project files.
  "cache": {"dir": ".cache/fallow"},
  "rules": {
    "complexity-crap": "error",
    "complexity-file-lines": "error"
  },
  "health": {"maxCrap": 30, "maxUnitSize": 40}
}
