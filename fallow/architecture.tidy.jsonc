// nostandard-tidy fallow architecture: cycles and policy at error; layers live in depcruise.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Cache per checkout in .cache/, so .fallow/ stays free for project files.
  "cache": {"dir": ".cache/fallow"},
  "rules": {
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "policy-violation": "error",
    "boundary-violation": "off"
  }
}
