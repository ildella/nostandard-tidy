// nostandard-tidy fallow basic: every finding is an error, default thresholds.
// No arrays here: fallow replaces arrays on extends, so entry/ignore stay per project.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    // unused code
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "error",
    "unused-load-data-keys": "error",
    "duplicate-exports": "error",
    // dependencies
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    // health
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    // architecture: ownership via project rulePacks; layers live in depcruise
    "policy-violation": "error",
    "boundary-violation": "off"
  },
  "health": {"maxCyclomatic": 20, "maxCognitive": 15, "maxUnitSize": 60},
  "duplicates": {"threshold": 5, "minLines": 4}
}
